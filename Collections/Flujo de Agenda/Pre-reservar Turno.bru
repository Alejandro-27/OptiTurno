meta {
  name: POST Pre-reservar Turno
  type: http
  seq: 2
}

post {
  url: {{base_url}}/turnos/reservar
  body: json
  auth: bearer
}

headers {
  Authorization: Bearer {{token_cliente}}
}

body:json {
  {
  "profesional_id": "{{profesional_id}}",
  "servicio_id": "{{servicio_id}}",
  "fecha": "2026-09-15",
  "hora_inicio": "10:00:00"
  }
}
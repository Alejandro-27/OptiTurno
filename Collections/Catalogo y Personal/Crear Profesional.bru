meta {
  name: Crear Profesional
  type: http
  seq: 2
}

post {
  url: {{base_url}}/profesionales
  body: json
  auth: bearer
}

headers {
  Authorization: Bearer {{token_auth}}
}

body:json {
  {
    "usuario_id": "{{usuario_real_id}}",
    "sucursal_id": "{{sucursal_id}}",
    "especialidad": "Cortes clásicos y degradados (Fade)"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    bru.setVar("profesional_id", data.id);
  }
}

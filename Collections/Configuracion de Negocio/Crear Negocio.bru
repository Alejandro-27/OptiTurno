meta {
  name: Crear Negocio
  type: http
  seq: 1
}

post {
  url: {{base_url}}/negocios
  body: json
  auth: bearer
}

headers {
  Authorization: Bearer {{token_auth}}
}

body:json {
  {
    "nombre": "Barberia El Elegante",
    "slug": "barberia-el-elegante"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    bru.setEnvVar("negocio_id", data.id);
  }
}

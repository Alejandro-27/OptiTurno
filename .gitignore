.vite/
build/
coverage/
*.log
.env*
!.env.example
EOF

# Dependencias de Node (Monorepo y subcarpetas)
node_modules/
.pnpm-store/

# Carpetas de compilación (Frontend)
frontend/dist/
dist/

# Artefactos de tsc emitidos junto a los fuentes del backend (sin outDir)
backend/src/**/*.js
backend/src/**/*.js.map

# Archivos de entorno local (Credenciales, tokens, etc.)
.env
.env.local
.env.*.local

# Cachés de editores y herramientas
.turbo/
.shared/
.ninja/
.cache/

# Snippets temporales del Supabase Studio (consultas ad-hoc)
supabase/snippets/

# --- BRUNO API CLIENT ---
# Ignorar los valores de entornos locales y privados de Bruno
**/Collections/environments/*.local.bru
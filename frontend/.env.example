# Frontend OptiTurno — variables de entorno (copiar a .env)
# NUNCA versionar .env real; este archivo es la referencia.

# URL base del backend API (Fastify). Omitir para usar el backend simulado.
VITE_API_URL=http://localhost:5000/api

# Modo demo SOLO si VITE_USE_MOCKS=true explícito. Si falta o es false,
# la app usa la API real y NUNCA muestra "Modo demostración" en la UI.
# En Vercel: configurá estas variables en Settings → Environment Variables
# (Production y Preview); el repo no se lleva los .env.
VITE_USE_MOCKS=false

# Credenciales de Supabase para el login real (auth por JWT en el backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
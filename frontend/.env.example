# Frontend OptiTurno — variables de entorno (copiar a .env)
# NUNCA versionar .env real; este archivo es la referencia.

# URL base del backend API (Fastify). Omitir para usar el backend simulado.
VITE_API_URL=http://localhost:5000/api

# Forzar modo demo (true) o API (false). Si se omite: API cuando VITE_API_URL existe.
VITE_USE_MOCKS=true

# Credenciales de Supabase para el login real (auth por JWT en el backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
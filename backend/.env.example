# Backend OptiTurno — variables de entorno (copiar a .env)
# NUNCA versionar .env real; este archivo es la referencia.

# Puerto del servidor Fastify
PORT=5000
NODE_ENV=development

# --- Supabase Local (Docker) ---
# Levantar con: npx supabase start (o pnpm db:start desde la raíz)
# Dashboard Studio: http://127.0.0.1:54323
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Para entorno remoto (Vercel/producción), comentar las líneas de arriba y descomentar: ---
# SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (service_role JWT)
# SUPABASE_ANON_KEY=eyJ... (anon JWT)

# CORS: lista de orígenes permitidos separados por coma (sin espacios).
# En producción poner la URL de Vercel: https://tu-app.vercel.app
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Stripe (pasarela de pagos). Test keys para desarrollo; live keys en producción.
# Obtener en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET se configura en preventa. En local se obtiene de `stripe listen`
# y NO es necesario para que el webhook funcione en test mientras se usa el CLI.
# En producción hay que fijarlo al secret real del endpoint del webhook en el dashboard.
STRIPE_WEBHOOK_SECRET=
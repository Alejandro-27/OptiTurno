# Backend OptiTurno — variables de entorno (copiar a .env)
# NUNCA versionar .env real; este archivo es la referencia.

# Puerto del servidor Fastify
PORT=5000
NODE_ENV=development

# Supabase (dashboard → Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Clave ANON: usada por el cliente `supabaseAuth` para login (signInWithPassword).
# Si usas el nombre legacy SUPABASE_KEY, el código lo toma como fallback.
SUPABASE_ANON_KEY=

# CORS: lista de orígenes permitidos separados por coma (sin espacios).
# En producción poner la URL de Vercel: https://tu-app.vercel.app
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Webhook de pagos: secret HMAC-SHA256. El webhook /api/pagos/webhook responde 503
# si no está configurado (deshabilitado por defecto). El cliente debe enviar el
# header `x-webhook-firma` = HMAC-SHA256(`${evento}.${transaccionId}`, secret).
# Generar con: openssl rand -hex 32
PAGOS_WEBHOOK_SECRET=